{
    "version": 4,
    "configurations": [
        {
            "name": "Emscripten",
            "intelliSenseMode": "clang-x64",
            "compilerPath": "${workspaceFolder}/emsdk/upstream/bin/clang++.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "defines": [
                "__EMSCRIPTEN__"
            ],
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "compilerArgs": [
                "-std=c++17"
            ]
        }
    ]
}